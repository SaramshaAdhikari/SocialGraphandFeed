# ==============================================================================
# SocialGraph Environment Configuration Example
# Copy this file to .env at the repository root and customize as needed.
# ==============================================================================

# Node Environment & Server Configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Database & Cache Endpoints
# ------------------------------------------------------------------------------
# NATIVE LOCAL DEVELOPMENT (Default):
# Connects to native local MongoDB Community Server on standard port 27017.
# MongoDB MUST be initialized as replica set 'rs0' for multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/socialgraph?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=socialgraph
# Redis is optional in development. Fastify gracefully falls back if not running.
REDIS_URL=redis://127.0.0.1:6379

# DOCKER COMPOSE ALTERNATIVE:
# If running MongoDB & Redis via Docker Compose, host-published ports are 27027 and 6387:
# MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=rs0&directConnection=true
# REDIS_URL=redis://127.0.0.1:6387

# Host-published ports for Docker Compose (override if host ports are occupied)
MONGODB_HOST_PORT=27027
REDIS_HOST_PORT=6387
MONGODB_TEST_HOST_PORT=27018
REDIS_TEST_HOST_PORT=6380
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000

# Frontend Configuration
# ------------------------------------------------------------------------------
# VITE_DATA_SOURCE:
# - 'live' connects to Fastify backend API (via proxy)
# - 'mock' uses in-memory mock fixtures for zero-dependency UI development
VITE_DATA_SOURCE=live
# Target URL for Vite development server proxy (/api -> backend)
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Security & Session Authentication
# ------------------------------------------------------------------------------
DEV_USER_BYPASS=false
SESSION_SECRET=development-only-session-secret-change-me
WEB_ORIGIN=http://localhost:3000
