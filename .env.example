# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database & Cache
# Docker service URLs are set inside Compose. These are host-side defaults.
MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=socialgraph
REDIS_URL=redis://127.0.0.1:6387

# Host-published ports (override if occupied)
MONGODB_HOST_PORT=27027
REDIS_HOST_PORT=6387
MONGODB_TEST_HOST_PORT=27018
REDIS_TEST_HOST_PORT=6380
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000

# Docker frontend development identity selector. This is not authentication;
# the backend accepts it only when DEV_USER_BYPASS=true outside production.
VITE_DATA_SOURCE=live
VITE_DEV_USER_ID=usr_0

# Development Flags
DEV_USER_BYPASS=true
