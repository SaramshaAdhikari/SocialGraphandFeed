# ==============================================================================
# SocialGraph Environment Configuration Example
# Copy this file to .env at the repository root and customize as needed.
# ==============================================================================

# Node Environment & Server Configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database Configuration (Choose Option A or Option B)
# ------------------------------------------------------------------------------

# OPTION A: SHARED TEAM DATABASE (MongoDB Atlas - 'socialgraph-dev')
# Obtain credentials from team lead / password manager and add your IP to Atlas allowlist.
# MONGODB_URI=mongodb+srv://<username>:<password>@socialgraph-dev.xxxx.mongodb.net/socialgraph?retryWrites=true&w=majority
# MONGODB_DB_NAME=socialgraph

# OPTION B: NATIVE LOCAL DEVELOPMENT (Standalone local mongod)
# Local MongoDB Community Server on standard port 27017 (configured as replica set rs0).
MONGODB_URI=mongodb://127.0.0.1:27017/socialgraph?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=socialgraph

# ------------------------------------------------------------------------------
# Test Database Isolation Safeguard
# Automated tests NEVER target the shared Atlas cluster.
# Tests strictly target the isolated local test instance.
# ------------------------------------------------------------------------------
MONGODB_TEST_URI=mongodb://127.0.0.1:27018
REDIS_TEST_URL=redis://127.0.0.1:6380

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# Shared Media Storage Configuration
# ------------------------------------------------------------------------------
# STORAGE_PROVIDER options: 'local' (disk storage) or 'cloudinary' (cloud CDN)
# When set to 'local', media is saved to packages/backend/public/uploads
STORAGE_PROVIDER=local

# CLOUDINARY CONFIGURATION (Required when STORAGE_PROVIDER=cloudinary)
# Set either CLOUDINARY_URL or the 3 individual keys below:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# VITE_DATA_SOURCE:
# - 'live' connects to Fastify backend API (via proxy)
# - 'mock' uses in-memory mock fixtures for zero-dependency UI development
VITE_DATA_SOURCE=live
# Target URL for Vite development server proxy (/api -> backend)
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# ------------------------------------------------------------------------------
# Security, Session Authentication & Rate Limiting
# ------------------------------------------------------------------------------
DEV_USER_BYPASS=false
SESSION_SECRET=development-only-session-secret-change-me
WEB_ORIGIN=http://localhost:3000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_SEC=60
FOOW_MAX_FOLLOWERS_THRESHOLD=500

# ------------------------------------------------------------------------------
# Atlas Seeding Safeguard
# Broad seeding against remote Atlas database is blocked unless explicitly enabled.
# ------------------------------------------------------------------------------
ALLOW_ATLAS_SEED=false
