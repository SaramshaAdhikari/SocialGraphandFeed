{
  "name": "@socialgraph/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --no-file-parallelism",
    "test:foundation": "vitest run test/foundation.test.ts",
    "test:services:up": "docker compose -f ../../docker-compose.test.yml up -d --wait",
    "test:services:down": "docker compose -f ../../docker-compose.test.yml down",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.28",
    "@socialgraph/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "mongodb": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
